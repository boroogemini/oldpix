# Optional ONNX model URL. Model must accept RGB NCHW float32 [0,1] and return RGB NCHW.
VITE_RESTORATION_MODEL_URL=

# Configure these as Cloudflare Pages secrets, never in VITE_ variables:
# WIRE_API_KEY
# WIRE_WEBHOOK_SECRET
# WIRE_QPAY_OPERATOR_ID (exact operator ID from Wire Dashboard → Connectors)
# APP_ORIGIN=https://your-production-domain